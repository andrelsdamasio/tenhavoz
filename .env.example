# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca expor ao browser — usada só nos webhooks (app/api/webhooks/*).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos back_urls/success_url dos checkouts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (Suas integrações > Credenciais / Webhooks)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Valor inicial (seed) do preço da campanha, em centavos de BRL — só é usado
# se a linha de app_settings não existir ainda no banco. Depois da migration
# 0002 rodar, o preço real é editado em /admin (painel do administrador).
CAMPAIGN_PRICE_BRL_CENTS=4900

# E-mails com acesso ao painel /admin (preço, templates habilitados), separados por vírgula
ADMIN_EMAILS=
