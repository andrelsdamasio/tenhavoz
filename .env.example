# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca expor ao browser — usada só nos webhooks (app/api/webhooks/*).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos back_urls/success_url dos checkouts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (Suas integrações > Credenciais / Webhooks)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Os preços dos dois prazos de campanha (72h e 7 dias) ficam salvos no banco
# (app_settings) e são editados em /admin — não há mais variável de ambiente
# pra isso.

# E-mails com acesso ao painel /admin (preço, templates habilitados), separados por vírgula
ADMIN_EMAILS=
